# =============================================================================
# Copier ce fichier :  copy .env.example .env
# Remplacer les valeurs — ne laissez pas USER, PASSWORD ou HOST tels quels !
# =============================================================================

# --- Option A : PostgreSQL local (Docker) ---
# 1. docker compose up -d
# 2. Utilisez exactement cette ligne :
DATABASE_URL="postgresql://maghreb:maghreb@localhost:5432/maghrebvoyage?schema=public"

# --- Option B : Neon (cloud gratuit) ---
# Créez un projet sur https://neon.tech → copiez la connection string :
# DATABASE_URL="postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/maghrebvoyage?sslmode=require"

# NextAuth (obligatoire)
NEXTAUTH_URL="http://localhost:3000"
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="changez-moi-32-caracteres-minimum-aleatoires"

# Stripe (optionnel en dev — mode démo sans clés)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
# Pays par défaut pour Stripe Connect Express (MA, FR, TN, DZ…)
STRIPE_CONNECT_DEFAULT_COUNTRY="FR"
# Commission MaghrebVoyage sur acomptes (Connect) — ex. 12 = 12 %
PLATFORM_FEE_PERCENT="12"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_EUR_TO_MAD="11"

# Google OAuth — les DEUX variables doivent être renseignées (sinon le bouton reste masqué)
# Console : https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# IA guide + matching — sélection AUTO : Groq (priorité) → OpenAI → conseiller local
# Recommandé (Groq + Llama) :
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Secours OpenAI (utilisé si Groq échoue ou indisponible) :
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Alternative : une seule clé via LLM_* (Groq, Ollama, Together)
# LLM_API_KEY=""
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_MODEL="llama-3.3-70b-versatile"
# Mettre true pour forcer le guide local (sans appels LLM)
OPENAI_DISABLE="false"

# VAPI — guide vocal (optionnel) https://dashboard.vapi.ai
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""
VAPI_WEBHOOK_SECRET=""

# Resend emails — https://resend.com (gratuit pour tests)
# Sans clé : les emails s'affichent dans la console du serveur (npm run dev)
RESEND_API_KEY=""
RESEND_FROM="MaghrebVoyage <onboarding@resend.dev>"
# En dev sans domaine vérifié : redirige tous les emails vers votre adresse Resend
RESEND_DEV_TO="you@example.com"
# Alertes nouvelle agence (optionnel — sinon email du compte admin en base)
ADMIN_NOTIFY_EMAIL=""

# Cron Vercel (rappel J-7 + newsletter partenaires) — Authorization: Bearer <secret>
# J-7 : GET /api/cron/pre-trip-reminder
# Partenaires (mensuel) : GET /api/cron/partner-newsletter
# Générer : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Obligatoire en production (sinon le cron renvoie 503).
CRON_SECRET=""

# --- Local dev (recommandé) ---
# Sans Cloudinary, les uploads agence vont dans public/uploads/ (dev uniquement).
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Paiement démo sans Stripe — uniquement si vous devez tester en prod (déconseillé)
# ALLOW_DEMO_PAYMENTS="false"
