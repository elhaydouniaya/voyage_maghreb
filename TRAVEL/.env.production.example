# Variables for Vercel / production.
# Configure these names in Vercel Project Settings -> Environment Variables.

# Required application and database settings
DATABASE_URL=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL=""
NEXT_PUBLIC_APP_URL=""

# Required for the active conversational assistant
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Required when bookings and online payments are enabled
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""

# Optional Google OAuth (configure both or neither)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional OpenAI fallback and legacy/basic chat paths
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_DISABLE=""

# Required for transactional email delivery
RESEND_API_KEY=""
RESEND_FROM=""
ADMIN_NOTIFY_EMAIL=""

# Required for the Vercel pre-trip reminder cron
CRON_SECRET=""

# Optional display conversion rate
NEXT_PUBLIC_EUR_TO_MAD=""

# Optional provider kill switch; leave unset for normal operation
GEMINI_DISABLE=""

# Do not set these in production:
# RESEND_DEV_TO
# ALLOW_DEMO_LOGIN
# ALLOW_DEMO_PAYMENTS
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS
