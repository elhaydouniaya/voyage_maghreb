# =============================================================================
# Variables pour Vercel / production
# Copier chaque clé dans Vercel → Project → Settings → Environment Variables
# =============================================================================

DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
NEXTAUTH_SECRET="generer-32-chars-minimum"
NEXTAUTH_URL="https://votre-domaine.vercel.app"
NEXT_PUBLIC_APP_URL="https://votre-domaine.vercel.app"

STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_live_..."

GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# IA — Groq recommandé ; OpenAI en secours automatique
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"
OPENAI_DISABLE="false"

# Gemini — guide client + intent (priorité avant OpenAI)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_DISABLE="false"

# VAPI guide vocal (optionnel)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=""
NEXT_PUBLIC_VAPI_ASSISTANT_ID=""
VAPI_WEBHOOK_SECRET=""

# Stripe Connect + commission plateforme
STRIPE_CONNECT_DEFAULT_COUNTRY="FR"
PLATFORM_FEE_PERCENT="12"

RESEND_API_KEY="re_..."
RESEND_FROM="MaghrebVoyage <noreply@votredomaine.com>"
ADMIN_NOTIFY_EMAIL="admin@votredomaine.com"

# Obligatoire en production (cron Vercel dans vercel.json)
CRON_SECRET="generer-avec-crypto-randomBytes"

# Ne PAS définir en production :
# RESEND_DEV_TO
# ALLOW_DEMO_PAYMENTS
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS
