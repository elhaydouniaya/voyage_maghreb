{
  "name": "maghreb-travel-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:baseline": "prisma migrate resolve --applied 20250523120000_init",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d",
    "db:setup": "prisma db push && npm run seed",
    "health": "node scripts/health-check.mjs",
    "health:prod": "node scripts/health-prod.mjs",
    "prod:smoke": "node scripts/smoke-prod.mjs",
    "prod:local": "node scripts/restart-prod.mjs",
    "prod:restart": "node scripts/restart-prod.mjs",
    "test": "tsx --test src/lib/__tests__/*.test.ts",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "lightningcss-win32-x64-msvc": "^1.32.0",
    "lucide-react": "^1.8.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.14",
    "openai": "^6.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.2.0",
    "stripe": "^22.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
