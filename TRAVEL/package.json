{
  "name": "maghreb-travel-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:cdc": "node scripts/db-cdc-check.mjs",
    "db:baseline": "prisma migrate resolve --applied 20250523120000_init",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d",
    "db:setup": "prisma db push && npm run seed",
    "health": "node scripts/health-check.mjs",
    "data:export": "node scripts/export-dataset.mjs",
    "health:prod": "node scripts/health-prod.mjs",
    "prod:smoke": "node scripts/smoke-prod.mjs",
    "audit": "node scripts/functional-audit.mjs",
    "audit:auth": "node scripts/auth-smoke.mjs",
    "audit:all": "node scripts/audit-all.mjs",
    "auto:run": "node scripts/auto-run.mjs",
    "auto:run:quick": "node scripts/auto-run.mjs --quick",
    "verify:booking": "tsx scripts/verify-booking-changes.ts",
    "verify:booking-e2e": "tsx scripts/verify-demo-booking.ts",
    "local:verify": "node scripts/verify-local.mjs",
    "prod:ready": "node scripts/prod-ready.mjs",
    "setup:full": "node scripts/setup-full.mjs",
    "audit:logs": "node scripts/seed-audit-logs.mjs",
    "reviews:approve": "node scripts/approve-pending-reviews.mjs",
    "analytics:seed": "node scripts/seed-behavior-analytics.mjs --clear",
    "agencies:slugs": "node scripts/backfill-agency-slugs.mjs",
    "env:fill": "node scripts/fill-missing-env.mjs",
    "integrations": "node scripts/check-integrations.mjs",
    "integrations:setup": "node scripts/fill-missing-env.mjs && node scripts/check-integrations.mjs",
    "images:check": "node scripts/check-images.mjs",
    "stripe:connect-demo": "node scripts/setup-stripe-connect-demo.mjs",
    "prod:restart": "node scripts/restart-prod.mjs",
    "test": "tsx --test src/lib/__tests__/*.test.ts",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['node_modules','.next','tsconfig.tsbuildinfo']) fs.rmSync(p,{recursive:true,force:true});\""
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "openai": "^6.34.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "stripe": "^22.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
}
