generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. Authentification & Utilisateurs
// ==========================================

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  role          Role      @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  requests      TravelRequest[]
  bookings      Booking[]
  agency        Agency?
  reviews       Review[]
  favorites     Favorite[]
  guideProfile  ClientGuideProfile?
  guideMessages GuideChatMessage[]
  behaviorEvents BehaviorEvent[]
}

model ClientGuideProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredDestinations String[] @default([])
  travelStyles          String[] @default([])
  budgetMax             Float?
  travelersCount        Int?
  preferredSeason       String?
  notes                 String?  @db.Text
  onboardingComplete    Boolean  @default(false)
  lastSummary           String?  @db.Text

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GuideChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  CLIENT
  AGENCY
  ADMIN
}

// ==========================================
// 2. Acteurs : Agences
// ==========================================

model Agency {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  slug            String?  @unique
  managerName     String
  email           String   @unique
  phoneNumber     String
  country         String
  city            String
  description     String   @db.Text
  coverage        String[] // Zones géographiques
  specialties     String[] // Types de voyages
  siret           String   @unique // N° immatriculation / licence
  
  verificationStatus AgencyStatus @default(PENDING)
  verificationNote   String?      @db.Text
  verifiedAt         DateTime?
  verifiedByUserId   String?

  stripeConnectAccountId       String?  @unique
  stripeConnectChargesEnabled  Boolean  @default(false)
  stripeConnectPayoutsEnabled  Boolean  @default(false)
  stripeConnectOnboardingComplete Boolean @default(false)

  notifyBookingsEmail       Boolean  @default(true)
  notifyPaymentsEmail       Boolean  @default(true)
  notifyPartnerNewsletter   Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trips           GroupTrip[]
  bookings        Booking[]
  payments        Payment[]
  leads           AgencyLead[]
  externalReviews ExternalReview[]
}

enum AgencyStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

// ==========================================
// 3. Demandes IA (TravelRequest)
// ==========================================

model TravelRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  
  // Données collectées
  destination     String
  isDateFlexible  Boolean  @default(false)
  startDate       DateTime?
  endDate         DateTime?
  durationDays    Int?
  numberOfTravelers Int
  adults          Int      @default(1)
  children        Int      @default(0)
  budgetMax       Float
  tripType        String[]
  tripStyle       String[]
  accommodation   String?
  transportIncluded Boolean @default(false)
  activities      String[]
  constraints     String?  @db.Text
  language        String   @default("FR")
  
  // Info contact (doublon pour accès rapide sans compte si besoin)
  clientName      String
  clientEmail     String
  clientPhone     String?
  
  // Données structurées par l'IA
  aiSummary       String?  @db.Text
  aiTags          String[]
  aiComplexity    Int      @default(1)
  destinationNormalized String?
  budgetLevel     String?  // 'low'|'medium'|'high'|'premium'
  dominantTripType String?

  status          RequestStatus @default(SUBMITTED)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]
  agencyLeads     AgencyLead[]
}

model AgencyLead {
  id                String   @id @default(cuid())
  agencyId          String
  agency            Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  travelRequestId   String
  travelRequest     TravelRequest @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  matchedTripIds    String[] @default([])
  bestCompatibility Int?
  readAt            DateTime?
  createdAt         DateTime @default(now())

  @@unique([agencyId, travelRequestId])
  @@index([agencyId, createdAt])
}

enum RequestStatus {
  SUBMITTED
  AI_PROCESSED
  MATCH_SUGGESTED
  CLIENT_CONFIRMED
  PAYMENT_PENDING
  PAID
  CLOSED
  CANCELLED
}

// ==========================================
// 4. Voyages de groupe (GroupTrip)
// ==========================================

model GroupTrip {
  id              String   @id @default(cuid())
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id])
  
  title           String
  slug            String   @unique
  destination     String
  description     String   @db.Text
  coverImage      String
  images          String[]
  
  startDate       DateTime
  endDate         DateTime
  durationDays    Int
  
  totalPrice      Decimal  @db.Decimal(10, 2)
  depositAmount   Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR")
  
  totalSpots      Int
  bookedSpots     Int      @default(0)
  reservedSpots   Int      @default(0) // seats held by active PENDING_PAYMENT bookings
  
  tripType        TripType
  season          Season   @default(OTHER)
  inclusions      String[]
  exclusions      String[]
  meetingPoint    String?
  programDays     String?  @db.Text
  guideLanguages  String[]
  physicalLevel   PhysicalLevel?
  
  aiTags          String[]
  status          TripStatus @default(DRAFT)
  isPublic        Boolean    @default(true)
  
  cancelledAt     DateTime?
  cancelReason    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings        Booking[]
  payments        Payment[]
  reviews         Review[]
  favorites       Favorite[]
}

enum TripType {
  DESERT
  CULTURE
  AVENTURE
  FAMILLE
  LUXE
  NATURE
  RELIGIEUX
  HISTORIQUE
}

enum Season {
  SPRING
  SUMMER
  AUTUMN
  WINTER
  OTHER
}

enum TripStatus {
  DRAFT
  PUBLISHED
  FULL
  CLOSED
  CANCELLED
}

enum PhysicalLevel {
  EASY
  MEDIUM
  SPORT
  EXPERT
}

// ==========================================
// 5. Réservations (Booking)
// ==========================================

model Booking {
  id              String   @id @default(cuid())
  
  groupTripId     String
  groupTrip       GroupTrip @relation(fields: [groupTripId], references: [id])
  
  agencyId        String
  agency          Agency    @relation(fields: [agencyId], references: [id])
  
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  
  travelRequestId String?
  travelRequest   TravelRequest? @relation(fields: [travelRequestId], references: [id])
  
  clientName      String
  clientEmail     String
  clientPhone     String?
  clientCountry   String?
  
  numberOfSeats   Int      @default(1)
  depositPaid     Decimal  @db.Decimal(10, 2)
  totalAmount     Decimal  @db.Decimal(10, 2)
  
  confirmationCode String  @unique
  cancellationToken String @unique @default(uuid())
  
  status          BookingStatus @default(PENDING_PAYMENT)
  expiresAt       DateTime?    // PENDING_PAYMENT expires after 30 min; null = no expiry
  cancellationReason String?
  cancelledAt     DateTime?
  
  payment         Payment?
  
  notes           String?  @db.Text

  preTripReminderSentAt DateTime?
  confirmationEmailSentAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  REFUNDED
  NO_SHOW
  EXPIRED
}

// ==========================================
// 6. Paiements (Payment)
// ==========================================

model Payment {
  id              String   @id @default(cuid())
  
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id])
  
  groupTripId     String
  groupTrip       GroupTrip @relation(fields: [groupTripId], references: [id])
  
  agencyId        String
  agency          Agency    @relation(fields: [agencyId], references: [id])
  
  stripeSessionId String   @unique
  stripePaymentIntentId String?
  stripeCustomerEmail String
  
  amount          Decimal  @db.Decimal(10, 2)
  currency        String   @default("EUR")
  paymentType     String   @default("deposit") // 'deposit' | 'service_fee'

  payoutMode          String   @default("platform") // platform | connect
  platformFeeCents    Int      @default(0)
  agencyNetCents      Int      @default(0)

  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  
  rawProviderResponse Json?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

// ==========================================
// 7. Administration & Logs
// ==========================================

model AuditLog {
  id              String   @id @default(cuid())
  action          String
  userId          String?
  details         String   @db.Text
  createdAt       DateTime @default(now())
}

// ==========================================
// 7b. Analytics comportementales (User Journey)
// ==========================================

enum JourneyStep {
  PAGE_VIEW
  SEARCH_START
  AI_MATCH_SUBMIT
  TRIP_VIEW
  CHECKOUT_START
  BOOKING_CONFIRMED
  LOGIN
  REGISTER
  GUIDE_CHAT
}

model BehaviorEvent {
  id          String      @id @default(cuid())
  step        JourneyStep
  path        String?
  sessionId   String?
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  role        String?
  metadata    Json?
  ipHash      String?
  durationMs  Int?
  createdAt   DateTime    @default(now())

  @@index([step, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}

// ==========================================
// 8. Avis clients (Review)
// ==========================================

model Review {
  id            String       @id @default(cuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  groupTripId   String?
  groupTrip     GroupTrip?   @relation(fields: [groupTripId], references: [id], onDelete: SetNull)

  authorName    String
  authorEmail   String
  rating        Int
  title         String
  content       String       @db.Text
  destination   String
  tripDate      String?
  helpfulCount  Int          @default(0)
  status        ReviewStatus @default(APPROVED)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// 8b. Avis externes (plateformes tierces)
// ==========================================

enum ExternalReviewPlatform {
  GOOGLE
  TRIPADVISOR
  FACEBOOK
  TRUSTPILOT
  VIATOR
}

model ExternalReview {
  id         String                 @id @default(cuid())
  agencyId   String
  agency     Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  platform   ExternalReviewPlatform
  authorName String
  rating     Int
  title      String?
  content    String                 @db.Text
  reviewDate DateTime
  sourceUrl  String?
  location   String?

  fetchedAt  DateTime               @default(now())

  @@index([agencyId])
}

// ==========================================
// 9b. Newsletter
// ==========================================

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("homepage")
  createdAt DateTime @default(now())
}

// ==========================================
// 9. Favoris (Favorite)
// ==========================================

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupTripId String
  groupTrip   GroupTrip @relation(fields: [groupTripId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, groupTripId])
}
